   "metadata": {},
   "source": [
    "## Requerimientos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "d9527d69",
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "import os"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "526bf4bf",
   "metadata": {},
   "source": [
    "## Configuraciones"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "04b8a7fd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# save path\n",
    "save_path='./data/'\n",
    "\n",
    "# Police stations data download apis\n",
    "overpass_url = \"https://overpass-api.de/api/interpreter\"\n",
    "# \"https://maps.mail.ru/osm/tools/overpass/api/interpreter\"\n",
    "# \"https://overpass.kumi.systems/api/interpreter\"\n",
    "\n",
    "\n",
    "years = [2020, 2021, 2022, 2023, 2024, 2025]\n",
    "\n",
    "# Chicago\n",
    "CHICAGO_API_URL='https://data.cityofchicago.org/resource/ijzp-q8t2.csv'\n",
    "chicago_save_path = os.path.join(save_path, \"chicago\")\n",
    "chicago_name = 'chicago'\n",
    "chicago_bbox = (41.64, -87.94, 42.02, -87.52)  # (min_lat, min_lon, max_lat, max_lon)\n",
    "\n",
    "# New York\n",
    "NEW_YORK_API_URL= 'https://data.cityofnewyork.us/resource/5uac-w243.csv'\n",
    "newyork_save_path = os.path.join(save_path, \"new_york\")\n",
    "newyork_name = 'new_york'\n",
    "newyork_bbox = (40.49, -74.26, 40.92, -73.70)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "125d259b",
   "metadata": {},
   "source": [
    "## Police Station data download"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3dbbce23",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "============================================================\n",
      "Descargando estaciones de policía...\n",
      "============================================================\n",
      "Consultando Overpass API (chicago): https://overpass-api.de/api/interpreter\n",
      "Datos descargados: 105 estaciones -> ./data/chicago\\police_stations\\chicago_police_stations.csv\n",
      "\n",
      "Consultando Overpass API (new_york): https://overpass-api.de/api/interpreter\n",
      "Datos descargados: 214 estaciones -> ./data/new_york\\police_stations\\new_york_police_stations.csv\n",
      "\n"
     ]
    }
   ],
   "source": [
    "import requests\n",
    "import csv\n",
    "import time\n",
    "\n",
    "def download_police_stations(city_name, city_save_path, bbox):\n",
    "    min_lat, min_lon, max_lat, max_lon = bbox\n",
    "    \n",
    "    # Query Overpass\n",
    "    overpass_query = f\"\"\"\n",
    "    [out:json][timeout:90];\n",
    "    (\n",
    "      node[\"amenity\"=\"police\"]({min_lat},{min_lon},{max_lat},{max_lon});\n",
    "      way[\"amenity\"=\"police\"]({min_lat},{min_lon},{max_lat},{max_lon});\n",
    "      relation[\"amenity\"=\"police\"]({min_lat},{min_lon},{max_lat},{max_lon});\n",
    "    );\n",
    "    out center;\n",
    "    \"\"\"\n",
    "    \n",
    "    data = None\n",
    "    \n",
    "    try:\n",
    "        print(f\"Consultando Overpass API ({city_name}): {overpass_url}\")\n",
    "        response = requests.get(overpass_url, params={\"data\": overpass_query}, timeout=100)\n",
    "        response.raise_for_status()\n",
    "        data = response.json()\n",
    "    except Exception as e:\n",
    "        print(f\"Fallo en {overpass_url}: {e}\")\n",
    "    \n",
    "    if not data or \"elements\" not in data:\n",
    "        raise RuntimeError(f\"No se pudo obtener data de Overpass para {city_name}\")\n",
    "    \n",
    "    output_dir = os.path.join(city_save_path, \"police_stations\")\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    \n",
    "    file_path = os.path.join(output_dir, f\"{city_name}_police_stations.csv\")\n",
    "    \n",
    "    with open(file_path, mode=\"w\", newline=\"\", encoding=\"utf-8\") as csvfile:\n",
    "        writer = csv.writer(csvfile)\n",
    "        writer.writerow([\"id\", \"type\", \"name\", \"lat\", \"lon\"])\n",
    "        \n",
    "        for el in data[\"elements\"]:\n",
    "            lat = el.get(\"lat\") or el.get(\"center\", {}).get(\"lat\")\n",
    "            lon = el.get(\"lon\") or el.get(\"center\", {}).get(\"lon\")\n",
    "            name = el.get(\"tags\", {}).get(\"name\", \"\")\n",
    "            writer.writerow([el.get(\"id\"), el.get(\"type\"), name, lat, lon])\n",
    "    \n",
    "    print(f\"Datos descargados: {len(data['elements'])} estaciones -> {file_path}\")\n",
    "    return file_path\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"Descargando estaciones de policía...\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "download_police_stations(chicago_name, chicago_save_path, chicago_bbox)\n",
    "print()\n",
    "download_police_stations(newyork_name, newyork_save_path, newyork_bbox)\n",
    "print()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "32622162",
   "metadata": {},
   "source": [
    "## Chicago crime data download"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "27842b1b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Downloaded data for year 2020 to ./data/chicago\\crimes\\chicago_crimes_2020.csv\n",
      "Downloaded data for year 2021 to ./data/chicago\\crimes\\chicago_crimes_2021.csv\n",
      "Downloaded data for year 2022 to ./data/chicago\\crimes\\chicago_crimes_2022.csv\n",
      "Downloaded data for year 2023 to ./data/chicago\\crimes\\chicago_crimes_2023.csv\n",
      "Downloaded data for year 2024 to ./data/chicago\\crimes\\chicago_crimes_2024.csv\n",
      "Downloaded data for year 2025 to ./data/chicago\\crimes\\chicago_crimes_2025.csv\n"
     ]
    }
   ],
   "source": [
    "for i in years:\n",
    "    filtered_url = f\"{CHICAGO_API_URL}?year={i}\"\n",
    "    response = requests.get(filtered_url)\n",
    "    response.raise_for_status()  \n",
    "\n",
    "    city_folder = os.path.join(chicago_save_path, 'crimes')\n",
    "    os.makedirs(city_folder, exist_ok=True)\n",
    "\n",
    "    file_path = os.path.join(city_folder, f\"{chicago_name}_crimes_{i}.csv\")\n",
    "    with open(file_path, 'wb') as f:\n",
    "        f.write(response.content)\n",
    "\n",
    "    print(f\"Downloaded data for year {i} to {file_path}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1554361f",
   "metadata": {},
   "source": [
    "## New York crime data download"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "5e557b04",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Downloaded data for year 2020 to ./data/new_york\\crimes\\new_york_crimes_2020.csv\n",
      "Downloaded data for year 2021 to ./data/new_york\\crimes\\new_york_crimes_2021.csv\n",
      "Downloaded data for year 2022 to ./data/new_york\\crimes\\new_york_crimes_2022.csv\n",
      "Downloaded data for year 2023 to ./data/new_york\\crimes\\new_york_crimes_2023.csv\n",
      "Downloaded data for year 2024 to ./data/new_york\\crimes\\new_york_crimes_2024.csv\n",
      "Downloaded data for year 2025 to ./data/new_york\\crimes\\new_york_crimes_2025.csv\n"
     ]
    }
   ],
   "source": [
    "for i in years:\n",
    "    filtered_url = f\"{NEW_YORK_API_URL}?$where=date_extract_y(CMPLNT_FR_DT)={i}\"\n",
    "    response = requests.get(filtered_url)\n",
    "    response.raise_for_status()  \n",
    "\n",
    "    city_folder = os.path.join(newyork_save_path, 'crimes')\n",
    "    os.makedirs(city_folder, exist_ok=True)\n",
    "\n",
    "    file_path = os.path.join(city_folder, f\"{newyork_name}_crimes_{i}.csv\")\n",
    "    with open(file_path, 'wb') as f:\n",
    "        f.write(response.content)\n",
    "\n",
    "    print(f\"Downloaded data for year {i} to {file_path}\")"
   ]
  }
